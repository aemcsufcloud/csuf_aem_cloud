        cq:template="/libs/cq/workflow/templates/model"
        jcr:mixinTypes="[]"
        jcr:primaryType="cq:PageContent"
        jcr:title="Test_AdobeSign"
        sling:resourceType="cq/workflow/components/pages/model">
        <flow
            jcr:primaryType="nt:unstructured"
            sling:resourceType="foundation/components/parsys">
            <afparticipantstep
                jcr:created="{Date}2020-09-02T03:01:33.613-07:00"
                jcr:createdBy="admin"
                jcr:description="Create and Assign a task based on an adaptive form or document of record"
                jcr:lastModified="{Date}2020-09-02T03:06:13.498-07:00"
                jcr:lastModifiedBy="admin"
                jcr:primaryType="nt:unstructured"
                jcr:title="Assign Task"
                sling:resourceType="fd/workflow/components/dashboard/afParticipantStep">
                <metaData
                    jcr:primaryType="nt:unstructured"
                    AF_PATH="/content/dam/formsanddocuments/adobe-sign/test"
                    DELEGATE_TO="assignee"
                    DUEDATE_UNIT="OFF"
                    DUEDATE_VALUE="[,]"
                    DYNAMIC_ASSIGNEE="[,]"
                    FORM_TYPE="AF"
                    HISTORY_DOR="READONLY_AF"
                    INPUT_DATAXML="Data.xml"
                    INPUT_FORM_ATTACHMENTS="Attachments"
                    IS_ATTACHMENT_ALLOWED="true"
                    IS_COMMENT_ALLOWED="true"
                    IS_NEXT_STEP_DATA_ALLOWED="true"
                    IS_PREVIOUS_STEP_DATA_ALLOWED="true"
                    OUTPUT_DATAXML="Data.xml"
                    OUTPUT_FORM_ATTACHMENTS="Attachments"
                    PARTICIPANT="admin"
                    PROCESS="com.adobe.fd.workspace.step.service.AssignFormStep"
                    PROCESS_AUTO_ADVANCE="false"
                    PROCESS_PARTICIPANT_TYPE="static"
                    PROVIDE_METADATA="true"
                    ROUTE_PROPERTYNAME="actionTaken"
                    SHOW_ACTION="true"
                    SHOW_ASSIGNEE="true"
                    SHOW_COMMENT="true"
                    SHOW_DOCUMENT_OF_COMPLETED_TASK="true"
                    SHOW_PRE_STEP_COMMENT_ATTACHMENT="true"
                    SHOW_RESET="true"
                    SHOW_SAVE="true"
                    SHOW_SUBMIT="true"
                    STATIC_ASSIGNEE="admin"
                    SUBTYPE="forms:assigntask"
                    TASK_PRIORITY="MEDIUM"
                    TIMEOUT_HANDLER="[,]"
                    USER_METADATA_RESOURCE="[,]"
                    WORK_ITEM_TYPE="AF_ASSIGN_STEP"
                    workflowStage="[,]"/>
            </afparticipantstep>
            <process_copy_copy_co
                jcr:created="{Date}2020-01-27T21:21:02.150-08:00"
                jcr:createdBy="admin"
                jcr:lastModified="{Date}2020-09-02T03:24:09.861-07:00"
                jcr:lastModifiedBy="admin"
                jcr:primaryType="nt:unstructured"
                jcr:title="Get value from xml for Employee"
                sling:resourceType="cq/workflow/components/model/process">
                <metaData
                    jcr:primaryType="nt:unstructured"
                    PROCESS="com.aem.web.models.workflow.GetValueinDataXml"
                    PROCESS_ARGS="empEmail=afData/afBoundData/form1/EmailAddress"
                    PROCESS_AUTO_ADVANCE="true"/>
            </process_copy_copy_co>
            <aftodorstep_copy_cop
                jcr:created="{Date}2020-03-22T09:57:46.759-07:00"
                jcr:createdBy="admin"
                jcr:description="Generate Document of Record"
                jcr:lastModified="{Date}2020-09-02T03:01:21.705-07:00"
                jcr:lastModifiedBy="admin"
                jcr:primaryType="nt:unstructured"
                jcr:title="Generate Document of Record"
                sling:resourceType="fd/workflow/components/dorGeneration/afToDorStep">
                <metaData
                    jcr:primaryType="nt:unstructured"
                    AF_PATH="/content/dam/formsanddocuments/adobe-sign/test"
                    DOR_PATH="RELATIVE_PLOAD:Test.pdf"
                    INPUT_ATTACHMENT="FOLDER_PAYLOAD:attachments"
                    INPUT_DATAXML="FOLDER_PAYLOAD:Data.xml"
                    LOCALE="en_US"
                    PROCESS="com.adobe.fd.workflow.dorGeneration.AFtoDORStep"
                    PROCESS_AUTO_ADVANCE="true"
                    WORK_ITEM_TYPE="AF_TO_DOR_STEP"/>
            </aftodorstep_copy_cop>
            <agreement_copy_copy
                jcr:created="{Date}2020-07-03T03:47:11.859-07:00"
                jcr:createdBy="admin"
                jcr:description="Sign Document"
                jcr:lastModified="{Date}2020-08-26T23:35:36.016-07:00"
                jcr:lastModifiedBy="admin"
                jcr:primaryType="nt:unstructured"
                jcr:title="Sign Document"
                sling:resourceType="fd/workflow/components/forms/Agreement">
                <metaData
                    jcr:primaryType="nt:unstructured"
                    FORM_WORK_ITEM_TYPE="ADOBESIGN_STEP"
                    inputpath="FOLDER_PAYLOAD:Cobra_Final_Notice.pdf"
                    locale="en_US"
                    name="Cobra Final Notice"
                    output="RELATIVE_PLOAD:Cobra_Final_Notice.pdf"
                    PROCESS="com.adobe.fd.workflow.adobesign.impl.AgreementCreation"
                    PROCESS_AUTO_ADVANCE="false"
                    PROCESS_PERSIST_ANONYMOUS_WORKITEM="true"
                    reminderFrequency="DAILY_UNTIL_SIGNED"
                    signatureFlow="SEQUENTIAL"
                    signConfig="/conf/AdobeSignConfiguration-NV/settings/cloudconfigs/echosign/adobesignaemnv"
                    signerDetails="Dynamic"
                    signersListScript="/apps/fd/workflow/scripts/adobesign/Cobra_Final_Notice.ecma"
                    variableForStatus="CFN_Status"/>
            </agreement_copy_copy>
