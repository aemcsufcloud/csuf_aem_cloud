<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:designPath="/libs/settings/wcm/designs/default"
        cq:lastModified="{Date}2019-05-07T04:28:02.429-07:00"
        cq:lastModifiedBy="admin"
        cq:template="/libs/cq/workflow/templates/model"
        jcr:mixinTypes="[]"
        jcr:primaryType="cq:PageContent"
        jcr:title="RequestFortimeOff"
        sling:resourceType="cq/workflow/components/pages/model">
        <flow
            jcr:primaryType="nt:unstructured"
            sling:resourceType="foundation/components/parsys">
            <process
                jcr:created="{Date}2018-08-14T11:27:30.753-07:00"
                jcr:createdBy="admin"
                jcr:lastModified="{Date}2018-08-14T11:28:28.163-07:00"
                jcr:lastModifiedBy="admin"
                jcr:primaryType="nt:unstructured"
                jcr:title="Set the value of intial step to N"
                sling:resourceType="cq/workflow/components/model/process">
                <metaData
                    jcr:primaryType="nt:unstructured"
                    PROCESS="com.aemforms.setvalue.core.SetValueInJson"
                    PROCESS_ARGS="afData.afUnboundData.data.initialStep,N"
                    PROCESS_AUTO_ADVANCE="true"/>
            </process>
            <afparticipantstep
                jcr:created="{Date}2018-08-14T10:49:17.761-07:00"
                jcr:createdBy="admin"
                jcr:description="Create and Assign a task based on an adaptive form or document of record"
                jcr:lastModified="{Date}2019-04-29T02:41:51.294-07:00"
                jcr:lastModifiedBy="admin"
                jcr:primaryType="nt:unstructured"
                jcr:title="Manager Approves"
                sling:resourceType="fd/workflow/components/dashboard/afParticipantStep">
                <metaData
                    jcr:primaryType="nt:unstructured"
                    AF_PATH="/content/dam/formsanddocuments/timeoffrequest"
                    DELEGATE_TO="assignee"
                    DUEDATE_UNIT="OFF"
                    DUEDATE_VALUE="[,]"
                    DYNAMIC_ASSIGNEE="[,]"
                    FORM_TYPE="AF"
                    HISTORY_DOR="READONLY_AF"
                    INPUT_DATAXML="Data.xml"
                    IS_ATTACHMENT_ALLOWED="true"
                    IS_COMMENT_ALLOWED="true"
                    IS_NEXT_STEP_DATA_ALLOWED="true"
                    IS_PREVIOUS_STEP_DATA_ALLOWED="true"
                    OUTPUT_DATAXML="Data.xml"
                    PARTICIPANT="p8tstadmin"
                    PROCESS="com.adobe.fd.workspace.step.service.AssignFormStep"
                    PROCESS_AUTO_ADVANCE="false"
                    PROCESS_PARTICIPANT_TYPE="static"
                    PROVIDE_METADATA="true"
                    ROUTE_PROPERTYNAME="actionTaken"
                    SHOW_ACTION="true"
                    SHOW_ASSIGNEE="true"
                    SHOW_COMMENT="true"
                    SHOW_DOCUMENT_OF_COMPLETED_TASK="true"
                    SHOW_PRE_STEP_COMMENT_ATTACHMENT="true"
                    SHOW_RESET="true"
                    SHOW_SAVE="true"
                    SHOW_SUBMIT="true"
                    STATIC_ASSIGNEE="p8tstadmin"
                    SUBTYPE="forms:assigntask"
                    TASK_PRIORITY="MEDIUM"
                    TIMEOUT_HANDLER="[,]"
                    USER_METADATA_RESOURCE="[,]"
                    WORK_ITEM_TYPE="AF_ASSIGN_STEP"
                    workflowStage="[,]"/>
            </afparticipantstep>
            <process_889302426
                jcr:created="{Date}2018-08-14T14:36:09.041-07:00"
                jcr:createdBy="admin"
                jcr:description="This process step capture the reviewers comments. The reviewer in this workflow is (manager). The comments ate stores in metadata property called managerComments. These comments can then be used in email notification"
                jcr:lastModified="{Date}2018-08-16T11:51:20.666-07:00"
                jcr:lastModifiedBy="admin"
                jcr:primaryType="nt:unstructured"
                jcr:title="Capture Reviewers Comments"
                sling:resourceType="cq/workflow/components/model/process">
                <metaData
                    jcr:primaryType="nt:unstructured"
                    PROCESS="com.aemforms.setvalue.core.CaptureComments"
                    PROCESS_ARGS="managerComments"
                    PROCESS_AUTO_ADVANCE="true"/>
            </process_889302426>
            <sendemail
                jcr:created="{Date}2019-05-07T04:17:07.139-07:00"
                jcr:createdBy="admin"
                jcr:description="Use the email step to send an HTML email. For example, you can use the email step to send a document of record, adaptive form and interactive communication link, and a PDF document on completion of a workflow."
                jcr:lastModified="{Date}2019-05-07T04:28:02.409-07:00"
                jcr:lastModifiedBy="admin"
                jcr:primaryType="nt:unstructured"
                jcr:title="Send Email"
                sling:resourceType="fd/workflow/components/email/sendemail">
                <metaData
                    jcr:primaryType="nt:unstructured"
                    attachmentFileNameType="Literal"
                    bccAddressType="Literal"
                    ccAddressType="Literal"
                    emailSubject="Please approve"
                    fromAddressType="Literal"
                    fromAddressValue="erpimaging@fullerton.edu"
                    hiddenCheckbox="[false,false,false]"
                    hiddenIsFormsAsset="[false,false,false]"
                    Key="[workitem_title,EmployeeID,workitem_url]"
                    PROCESS="com.adobe.fd.workflow.email.SendEmailStep"
                    PROCESS_AUTO_ADVANCE="true"
                    subjectType="Literal"
                    templatemetadatatype="[Literal,Metadata,Literal]"
                    templatePath="/libs/fd/dashboard/templates/email/sampleEmail.txt"
                    toAddressType="Literal"
                    toAddressValue="swathi.kumari@thoughtfocus.com"
                    urlPath="[,,]"
                    Value="[,managerComments,]"/>
            </sendemail>
        </flow>
    </jcr:content>
</jcr:root>
