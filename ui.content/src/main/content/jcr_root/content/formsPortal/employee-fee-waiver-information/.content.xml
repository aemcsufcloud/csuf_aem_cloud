                jcr:primaryType="nt:unstructured"
                sling:resourceType="wcm/foundation/components/responsivegrid">
                <text
                    jcr:created="{Date}2019-12-12T12:24:06.108+05:30"
                    jcr:createdBy="admin"
                    jcr:lastModified="{Date}2021-01-31T22:58:32.923-08:00"
                    jcr:lastModifiedBy="admin"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="wcm/foundation/components/text"
                    text="&lt;p>&lt;b>&amp;nbsp; TAX IMPLICATIONS OF FEE WAIVER&lt;/b>&lt;/p>&#xa;&lt;p style=&quot;text-align: left;&quot;>&lt;b>&amp;nbsp; IRC Section 117(d) Qualified Tuition Reduction&lt;/b> applies to any reduction in tuition provided by California State University (CSU) to either an employee for the education of an employee or the dependent child or spouse of the employee. A qualified&amp;nbsp; tuition reduction is tax-free only if it is for education &lt;b>&lt;u>below&lt;/u>&amp;nbsp;&lt;/b>the graduate level, except for graduate students engaged in&amp;nbsp; teaching or research at the CSU.&lt;/p>&#xa;&lt;p>&amp;nbsp; If the educational institution requires the recipient of the qualified tuition reduction to provide teaching and or research services to that institution in return for the tuition reduction, the benefit becomes taxable.&lt;/p>&#xa;&lt;p>&lt;b>&amp;nbsp; IRC Section 127/Educational Assistance Program&lt;/b> applies to educational assistance benefits to employees &lt;b>&lt;u>only&lt;/u>&lt;/b>, up to a maximum of $5,250 per calendar year. Exclusion applies to graduate level courses.&lt;/p>&#xa;&lt;p>&lt;b>&amp;nbsp; Note that the course level determines taxability, not the education level of the employee.&lt;/b>&lt;/p>&#xa;"
                    textIsRich="true">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                        <default
                            jcr:primaryType="nt:unstructured"
                            offset="1"
                            width="10"/>
                    </cq:responsive>
                </text>
                <image
                    jcr:created="{Date}2020-05-03T22:38:07.370-07:00"
                    jcr:createdBy="admin"
                    jcr:lastModified="{Date}2021-01-31T22:52:53.678-08:00"
                    jcr:lastModifiedBy="admin"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="wcm/foundation/components/image"
                    fileName="Employee_Fee_Waiver_Information.png"
                    fileReference="/content/dam/CSUF Assets/Emp_Fee_Waiver_Ins_Img1.PNG"
                    height="0"
                    width="0">
                    <file/>
                </image>
                <text_1270779331
                    jcr:created="{Date}2020-05-03T22:40:24.371-07:00"
                    jcr:createdBy="admin"
                    jcr:lastModified="{Date}2021-01-31T22:59:44.726-08:00"
                    jcr:lastModifiedBy="admin"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="foundation/components/text"
                    text="&lt;p>&amp;nbsp; &amp;nbsp;*All graduate-level employees receiving a benefit of over $5,250 in a calendar year will be treated as taxable and will be subject to withholding taken from the employee’s pay warrant. The employees may consult a personal tax advisor to determine if courses taken are deductible on their tax return.&lt;/p>&#xa;&lt;p style=&quot;text-align: left;&quot;>&amp;nbsp; The waived fee amount determined to be taxable should be included as wages on the employee’s Form W-2 and applicable taxes withheld. The imputed taxable income is typically reported by the 10th of the month following the date of the constructive receipt to the State Controller’s Office (SCO), which is the semester’s census date. The usage of the campus census date as the “constructive receipt” of the fee waiver benefit is to eliminate adverse tax reporting on imputed income when an employee’s dependent drops courses.&lt;/p>&#xa;&lt;p>&amp;nbsp; Currently, the&lt;b> flat tax&lt;/b> rate is &lt;b>36.25% &lt;/b>comprised of: federal tax (22%), state tax (6.6%), Social Security tax (6.2%), and Medicare tax (1.45%); and may be adjusted annually.&lt;/p>&#xa;&lt;p>&lt;b>&amp;nbsp; You will be notified via email in advance before the taxes are withheld from your pay warrant.&lt;/b>&lt;/p>&#xa;&lt;p>&amp;nbsp; Please refer to the Fee Waiver &amp;amp; Reduction Program/Administrative Guide issued by the Office of the Chancellor for additional information.&lt;/p>&#xa;"
                    textIsRich="true"/>
            </responsivegrid_436751876>
