                <table
                    jcr:created="{Date}2021-11-09T22:49:02.721-08:00"
                    jcr:createdBy="admin"
                    jcr:lastModified="{Date}2024-09-25T23:35:57.829-07:00"
                    jcr:lastModifiedBy="admin"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="foundation/components/table"
                    tableData="&lt;table width=&quot;80%&quot; cellspacing=&quot;0&quot; cellpadding=&quot;1&quot; border=&quot;1&quot;>&#xa;&lt;tbody>&lt;tr>&lt;td width=&quot;20%&quot;>&lt;b>CHRS Role&lt;/b>&lt;/td>&#xa;&lt;td>&lt;b>Required Training&lt;/b>&lt;/td>&#xa;&lt;td>&lt;b>Description&lt;/b>&lt;/td>&#xa;&lt;td>&lt;b>Centralized or Distributed&lt;/b>&lt;/td>&#xa;&lt;/tr>&lt;tr>&lt;td>TAE Appt Data Entry/Review&lt;/td>&#xa;&lt;td width=&quot;20%&quot;>&lt;a href=&quot;https://ds.calstate.edu/?entityID=https%3A%2F%2Fidp.calstate.edu%2Fproxy%2Fsaml%2Fsp%2Fsumtotal&amp;amp;return=https%3A%2F%2Fidp.calstate.edu%2Fsumtotal%2FShibboleth.sso%2FLogin%3FSAMLDS%3D1%26target%3Dss%253Amem%253A3509ec2819eb18fd9f1564fdf07cadbb0f345dd5e0e7a651e9d68dff7b3c6db5&quot; target=&quot;_blank&quot;>IT: CHRS Temporary Academic Employment Data Entry &amp;amp; Reviewer Training&lt;/a>&lt;/td>&#xa;&lt;td width=&quot;40%&quot;>This permission role is used by depts to appoint temporary academic employees in bargaining unit 3 (lecturers, coaches, librarians, etc.) and unit 11 (Academic Student Employees - ISA, TA, GA).&lt;/td>&#xa;&lt;td width=&quot;20%&quot;>Distributed Users&lt;/td>&#xa;&lt;/tr>&lt;tr>&lt;td>TAE MPP Approver&lt;/td>&#xa;&lt;td>&lt;a href=&quot;https://ds.calstate.edu/?entityID=https%3A%2F%2Fidp.calstate.edu%2Fproxy%2Fsaml%2Fsp%2Fsumtotal&amp;amp;return=https%3A%2F%2Fidp.calstate.edu%2Fsumtotal%2FShibboleth.sso%2FLogin%3FSAMLDS%3D1%26target%3Dss%253Amem%253A5c2524b52da50aa511bc55b23a952a82da104e7f4c6b1c05cd2b1401a388994d&quot; target=&quot;_blank&quot;>IT: CHRS Temporary Academic Employment MPP Approver Training&lt;/a>&lt;/td>&#xa;&lt;td>This permission role is used by depts to approve appointments for temporary academic employees in bargaining unit 3 (lecturers, coaches, librarians, etc.) and unit 11 (Academic Student Employees - ISA, TA, GA).&lt;/td>&#xa;&lt;td>Distributed Users&lt;/td>&#xa;&lt;/tr>&lt;tr>&lt;td width=&quot;10%&quot; style=&quot;text-align: left;&quot;>Recruiting&lt;/td>&#xa;&lt;td width=&quot;181&quot;>IT Training TBD&lt;/td>&#xa;&lt;td width=&quot;156&quot;>This permission role is used by depts to conduct a search to hire employees.This applies to all employee groups on campus (faculty, temporary academic employees, staff, MPP, non-represented student assistants).&lt;/td>&#xa;&lt;td>Distributed Users&lt;/td>&#xa;&lt;/tr>&lt;tr>&lt;td>Timekeeper&lt;/td>&#xa;&lt;td>&lt;a href=&quot;https://ds.calstate.edu/?entityID=https%3A%2F%2Fidp.calstate.edu%2Fproxy%2Fsaml%2Fsp%2Fsumtotal&amp;amp;return=https%3A%2F%2Fidp.calstate.edu%2Fsumtotal%2FShibboleth.sso%2FLogin%3FSAMLDS%3D1%26target%3Dss%253Amem%253Aba1b1ba95450f4666ab71df311771d6ae320602a0c7fff957746aa13ebb849bf&quot; target=&quot;_blank&quot;>IT: CHRS Timekeeper Absence &amp;amp; Timesheet Review Training&lt;/a>&lt;/td>&#xa;&lt;td>This permission role is used by dept Timekeepers to review all employees' time submissions and/or No Leave Taken and/or absences.&lt;/td>&#xa;&lt;td>Distributed Users&lt;/td>&#xa;&lt;/tr>&lt;tr>&lt;td width=&quot;300&quot; height=&quot;35&quot;>MPP Time Approver Depts&lt;/td>&#xa;&lt;td width=&quot;181&quot;>&lt;a href=&quot;https://ds.calstate.edu/?entityID=https%3A%2F%2Fidp.calstate.edu%2Fproxy%2Fsaml%2Fsp%2Fsumtotal&amp;amp;return=https%3A%2F%2Fidp.calstate.edu%2Fsumtotal%2FShibboleth.sso%2FLogin%3FSAMLDS%3D1%26target%3Dss%253Amem%253A587ad9caa72cad6033f1aedaed12b51e57059a3c8d11698a5aa48a039cc8090d&quot; target=&quot;_blank&quot;>IT: CHRS Manager Absence, no Leave taken, and Timesheet Approval Training&lt;/a>&lt;/td>&#xa;&lt;td width=&quot;156&quot;>This permission role is used by dept MPP approvers to specify which depts they need approval access to.To request this access, list out which dept ID numbers the MPP requires.&amp;nbsp;&lt;/td>&#xa;&lt;td width=&quot;153&quot;>Distributed Users&lt;/td>&#xa;&lt;/tr>&lt;tr>&lt;td width=&quot;300&quot; height=&quot;21&quot;>Benefits Staff&lt;/td>&#xa;&lt;td width=&quot;181&quot;>&amp;nbsp;&lt;/td>&#xa;&lt;td width=&quot;156&quot;>&amp;nbsp;&lt;/td>&#xa;&lt;td width=&quot;153&quot;>Centralized Users&lt;/td>&#xa;&lt;/tr>&lt;tr>&lt;td width=&quot;300&quot; height=&quot;21&quot;>Benefits Officer&lt;/td>&#xa;&lt;td width=&quot;181&quot;>&amp;nbsp;&lt;/td>&#xa;&lt;td width=&quot;156&quot;>&amp;nbsp;&lt;/td>&#xa;&lt;td width=&quot;153&quot;>Centralized Users&lt;/td>&#xa;&lt;/tr>&lt;tr>&lt;td width=&quot;300&quot; height=&quot;35&quot;>Talent Acquisition&lt;/td>&#xa;&lt;td width=&quot;181&quot;>Training will be provided outside of HR ARF - will be conducted by HRDI&lt;/td>&#xa;&lt;td width=&quot;156&quot;>&amp;nbsp;&lt;/td>&#xa;&lt;td width=&quot;153&quot;>Centralized Users&lt;/td>&#xa;&lt;/tr>&lt;tr>&lt;td>Payroll SME&lt;/td>&#xa;&lt;td width=&quot;181&quot;>Training will be provided outside of HR ARF - will be conducted by HRDI&lt;/td>&#xa;&lt;td width=&quot;156&quot;>&amp;nbsp;&lt;/td>&#xa;&lt;td width=&quot;153&quot;>Centralized Users&lt;/td>&#xa;&lt;/tr>&lt;tr>&lt;td>Recruiting&lt;/td>&#xa;&lt;td>Training will be provided outside of HR ARF - will be conducted by HRDI&lt;/td>&#xa;&lt;td>&amp;nbsp;&lt;/td>&#xa;&lt;td>Centralized Users&lt;/td>&#xa;&lt;/tr>&lt;tr>&lt;td>TAE Payroll&lt;/td>&#xa;&lt;td>Training will be provided outside of HR ARF - will be conducted by HRDI&lt;/td>&#xa;&lt;td>&amp;nbsp;&lt;/td>&#xa;&lt;td>Centralized Users&lt;/td>&#xa;&lt;/tr>&lt;tr>&lt;td>TAE Super User&lt;/td>&#xa;&lt;td>Training will be provided outside of HR ARF - will be conducted by HRDI&lt;/td>&#xa;&lt;td>&amp;nbsp;&lt;/td>&#xa;&lt;td>Centralized Users&lt;/td>&#xa;&lt;/tr>&lt;tr>&lt;td>Student Assistant Appointment Processing&lt;/td>&#xa;&lt;td>&lt;a href=&quot;https://ds.calstate.edu/?entityID=https%3A%2F%2Fidp.calstate.edu%2Fproxy%2Fsaml%2Fsp%2Fsumtotal&amp;amp;return=https%3A%2F%2Fidp.calstate.edu%2Fsumtotal%2FShibboleth.sso%2FLogin%3FSAMLDS%3D1%26target%3Dss%253Amem%253Adcc6fd97e5a26654cd3894d62f729e5bfe811ca2b8af7e6623c35599557aff4c&quot; target=&quot;_blank&quot;>Student Assistant Appointment Processing&lt;/a>&lt;/td>&#xa;&lt;td>This permission role is used by CENTRALIZED HRDI USERS ONLY (Payroll) to appoint non-represented student assistants to a concurrent job, to rehire them, or process pay increases.&lt;/td>&#xa;&lt;td>Centralized UsersIT: CHRS Temporary Academic Employment MPP Approver Trainin&lt;/td>&#xa;&lt;/tr>&lt;/tbody>&lt;/table>&#xa;"
