erun:yes">  </span>D,<span style="xfa-spacerun:yes">  </span>or CR count<span style="xfa-spacerun:yes">  </span>toward<span style="xfa-spacerun:yes">  </span>earned<span style="xfa-spacerun:yes">  </span>units;<span style="xfa-spacerun:yes">  </span>grades<span style="xfa-spacerun:yes">  </span>of<span style="xfa-spacerun:yes">  </span>IC,<span style="xfa-spacerun:yes">  </span>SP,<span style="xfa-spacerun:yes">  </span>WF,<span style="xfa-spacerun:yes">  </span>WU,<span style="xfa-spacerun:yes">  </span>AU,<span style="xfa-spacerun:yes">  </span>I,<span style="xfa-spacerun:yes">  </span>RD,<span style="xfa-spacerun:yes">  </span>F,<span style="xfa-spacerun:yes">  </span>U,<span style="xfa-spacerun:yes">  </span>W,<span style="xfa-spacerun:yes">  </span>or<span style="xfa-spacerun:yes">  </span>NC<span style="xfa-spacerun:yes">  </span>will<span style="xfa-spacerun:yes">  </span>count<span style="xfa-spacerun:yes">  </span>toward attempted<span style="xfa-spacerun:yes">  </span>units,<span style="xfa-spacerun:yes">  </span>but<span style="xfa-spacerun:yes">  </span>not<span style="xfa-spacerun:yes">  </span>earned<span style="xfa-spacerun:yes">  </span>units.<span style="xfa-spacerun:yes">  </span>Secondly,<span style="xfa-spacerun:yes">  </span>we<span style="xfa-spacerun:yes">  </span>look<span style="xfa-spacerun:yes">  </span>at<span style="xfa-spacerun:yes">  </span>your<span style="xfa-spacerun:yes">  </span>cumulative<span style="xfa-spacerun:yes">  </span>GPA<span style="xfa-spacerun:yes">  </span>to<span style="xfa-spacerun:yes">  </span>determine<span style="xfa-spacerun:yes">  </span>whether<span style="xfa-spacerun:yes">  </span>you<span style="xfa-spacerun:yes">  </span>meet<span style="xfa-spacerun:yes">  </span>the minimum based on your grade level:</p><p style="font-style:italic;text-decoration:none;letter-spacing:0in">After the 2<span style="xfa-spacerun:yes">     </span>term<span style="xfa-spacerun:yes">   </span><span style="font-style:normal"><span style="xfa-spacerun:yes">                                                                                                     </span></span></p><p style="font-style:italic;text-decoration:none;letter-spacing:0in">After the 3<span style="xfa-spacerun:yes">     </span>term<span style="xfa-spacerun:yes">           </span><span style="font-style:normal"><span style="xfa-spacerun:yes">                                                                                              </span></span></p><p style="font-style:italic;text-decoration:none;letter-spacing:0in">Juniors, Seniors and all other undergraduates beyond the 4<span style="xfa-spacerun:yes">     </span>term<span style="xfa-spacerun:yes">   </span><span style="font-style:normal"><span style="xfa-spacerun:yes">               </span></span></p><p style="text-decoration:none;letter-spacing:0in"><br/></p><p style="font-style:italic;text-decoration:none;letter-spacing:0in">2<span style="xfa-spacerun:yes">    </span>BA<span style="xfa-spacerun:yes"> </span><span style="font-style:normal"><span style="xfa-spacerun:yes">                                                                                                                            </span></span></p><p style="font-style:italic;text-decoration:none;letter-spacing:0in">Credential<span style="xfa-spacerun:yes"> </span><span style="font-style:normal"><span style="xfa-spacerun:yes">                                                                                                                      </span></span></p><p style="font-style:italic;text-decoration:none;letter-spacing:0in">Graduate<span style="xfa-spacerun:yes"> </span><span style="font-style:normal"><span style="xfa-spacerun:yes">                                                                                                                      </span></span></p><p style="margin-bottom:5pt;font-size:12pt;font-weight:bold;text-decoration:none;letter-spacing:0in">INCOMPLETES/GRADE CORRECTIONS<span styl