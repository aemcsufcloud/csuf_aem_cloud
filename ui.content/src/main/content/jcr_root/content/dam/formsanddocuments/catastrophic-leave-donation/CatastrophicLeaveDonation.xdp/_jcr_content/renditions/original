         <draw name="Text1" w="203.2mm" h="91.901mm">
            <ui>
               <textEdit/>
            </ui>
            <value>
               <exData contentType="text/html">
                  <body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p style="font-family:'Times New Roman';text-decoration:none;letter-spacing:0in">Instructions:</p><ul style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in;list-style-type:disc"><li>Payroll Services will update your leave balance via Absence Management when your donation has been used.</li><li>Under the provisions of the Catastrophic Leave Donation Program, each employee may donate their leave credits, the</li></ul><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in">maximum donations are set by the the collective bargaining agreement the donor falls under. Leave credits are not</p><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in">considered donated until transfer by Payroll. Payroll will monitor the<span style="xfa-spacerun:yes"> </span><span style="letter-spacing:0em">actual</span> number of hours transferred to ensure that the</p><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in">maximum is not exceeded. The maximums are set by fiscal year.</p><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in"><br/></p><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in">Following are the maximums by collective bargaining:</p><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in"><br/></p><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in">Donor Category Maximum<span style="xfa-spacerun:yes">                                               </span>Donation Hours</p><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in">Unit 1 Union of American Physicians<span style="xfa-tab-count:3">                           </span>16</p><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in">Units 2, 5, 7, 9 (CSUEU)<span style="xfa-tab-count:5">                                             </span>40</p><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in">Unit 3 California Faculty Association (CFA)<span style="xfa-tab-count:3">                           </span>40</p><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in">Unit 4 Academic Professionals of California<span style="xfa-tab-count:3">                           </span>40</p><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in">Unit 6 State Employees Trades Council (SETC)<span style="xfa-tab-count:2">                  </span>40</p><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in">Unit 8 Statewide University Police Association (SUPA)<span style="xfa-tab-count:1">         </span>40</p><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in">Unit 10 International Union of Operating Engineers<span style="xfa-tab-count:2">                  </span>40</p><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in">Unit 11 Academic Student Employees (TA's only)<span style="xfa-tab-count:2">                  </span>16</p><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in">Confidentials (C99)<span style="xfa-tab-count:5">                                             </span>40</p><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in">Management Personnel Plan (M80)<span style="xfa-tab-count:4">                                    </span>40</p><p style="text-align:left;font-family:'Times New Roman';font-size:10pt;font-weight:normal;text-decoration:none;letter-spacing:0in">Executive (M98)<span style="xfa-tab-count:6">                                                      </span>40</p></body>
               </exData>
