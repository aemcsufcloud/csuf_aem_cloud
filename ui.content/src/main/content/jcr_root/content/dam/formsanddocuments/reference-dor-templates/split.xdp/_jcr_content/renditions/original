 * @param field is HiddenTextField inside check box subform
 * @textField is where selected options value is assigned
 **/
<script contentType="application/x-javascript" name="dorCheckBoxMerge">
 function mergeData(field, textField) {
 var values = field.rawValue;
 var lengthOfValues;
 var indexOfComma;
 var checkBoxButton;
 var checkBoxName;
 
 // if check box is inside table check box title text field will be hidden
 // make it visible and hide check boxes
 textField.presence = "visible";
 hideCheckBoxes(field);
 
 // if no option selected hide check box subform
 if ( values != null ) {
 textField.rawValue = "";
 
 lengthOfValues = values.toString().length;
 
 // get a value from comma separated list of values and append it to textField
 while ( true ) {
 indexOfComma = values.toString().indexOf(",");
 if ( indexOfComma == -1 ) { // last value
 // get check box button corresponding to value
 checkBoxButton = field.resolveNode(field.parent.name + (values.toString()).replace(/^\s+|\s+$/g, ''));
 if ( checkBoxButton ) {
 // append caption of checkBoxButton to textField
 textField.rawValue = [textField.rawValue, checkBoxButton.caption.value.text.value].join('');
 }
 break;
 }
 // get check box button corresponding to value
 checkBoxName = field.parent.name + (values.toString().substring(0, indexOfComma)).replace(/^\s+|\s+$/g, '');
 checkBoxButton = field.resolveNode(checkBoxName);
 if ( checkBoxButton )
 // append caption of checkBoxButton to textField
 textField.rawValue = [textField.rawValue, checkBoxButton.caption.value.text.value, dorValueSeparator.value].join('');
 lengthOfValues = lengthOfValues - indexOfComma + 1;
 values = values.substring(indexOfComma + 1, lengthOfValues);
 }
 }
 }
 
 function hideCheckBoxes(field) {
 var oNodes = field.parent.nodes;
