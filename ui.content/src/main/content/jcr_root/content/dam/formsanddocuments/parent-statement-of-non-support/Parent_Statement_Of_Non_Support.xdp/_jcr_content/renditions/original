            </ui>
            <value>
               <exData contentType="text/html">
                  <body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p style="font-weight:bold;letter-spacing:0in"><br/></p><ul style="text-align:justify;letter-spacing:0in;list-style-type:disc"><li style="text-align:left">Grandparents, foster parents, legal guardians, aunts and uncles are NOT considered parent unless they have legally adopted you.</li><li style="text-align:left">Any person who is not married to your parent and who is not a legal or biological parent</li></ul></body>
               </exData>
