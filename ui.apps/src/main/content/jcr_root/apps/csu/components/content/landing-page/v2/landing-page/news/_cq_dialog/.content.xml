<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="News Properties"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <news-title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldDescription="Please add News Title"
                        fieldLabel="News Title"
                        name="./newsTitle"
                        value="sample news title"/>
                    <type
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldDescription="Please select News Type"
                        fieldLabel="Type"
                        name="./type">
                        <items jcr:primaryType="nt:unstructured">
                            <news
                                jcr:primaryType="nt:unstructured"
                                text="News"
                                value="NEWS"/>
                            <announcement
                                jcr:primaryType="nt:unstructured"
                                text="Announcement"
                                value="ANNOUNCEMENT"/>
                        </items>
                    </type>
                    <make-publishDate-string
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/granite/ui/components/coral/foundation/form/hidden"
                        about="This causes newsPublishDate to be saved as a String in JCR instead of Date"
                        name="./newsPublishDate@TypeHint"
                        value="String"/>
                    <publish-date
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                        fieldLabel="News Publish Date"
                        name="./newsPublishDate"
                        required="{Boolean}true"
                        valueFormat="MM/DD/YYYY"/>
                </items>
            </column>
        </items>
    </content>
</jcr:root>
